# Regole condivise per mantenere coerente lo stile dei file del progetto.
root = true

# Impostazioni predefinite.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python segue l'indentazione standard a quattro spazi.
[*.py]
indent_size = 4
max_line_length = 88

# Markdown conserva gli spazi finali eventualmente usati per i ritorni a capo.
[*.md]
trim_trailing_whitespace = false
max_line_length = 80
