#!/usr/sbin/nft -f

# =============================================================================
# MARITIME ZTA - NFTABLES FIREWALL RULES
#
# This rules uses variables from the container environment
# firewall_perimeter - NFTABLES_ prefix.
# They are substituted at startup by envsubst in entrypoint.sh.
#
# Variables used in this file:
#   NFTABLES_ENVOY_IP           - IP of the PEP gateway (Envoy)
#   NFTABLES_OPA_IP             - IP of the PDP engine (OPA)
#   NFTABLES_MONGODB_IP         - IP of the primary database (MongoDB)
#   NFTABLES_API_IP             - IP of the API backend
#   NFTABLES_SPLUNK_IP          - IP of the SIEM (Splunk)
#   NFTABLES_CORPORATE_NET      - Corporate subnet (CIDR)
#   NFTABLES_PEP_PORT           - Port exposed by PEP (Envoy listener)
#   NFTABLES_OPA_PORTS          - Ports of OPA (set notation, e.g. {8181,9191})
#   NFTABLES_MONGO_PORT         - Port of MongoDB
#   NFTABLES_API_PORT           - Port of API backend
#   NFTABLES_SIEM_HEC_PORT      - Splunk HEC port
#   NFTABLES_SIEM_WEB_PORT      - Splunk Web UI port
#   NFTABLES_ENVOY_ADMIN_PORT   - Envoy admin interface port
# =============================================================================

flush ruleset

table inet filter {

    chain input {
        type filter hook input priority 0; policy drop;

        iif lo accept
        ct state established,related accept
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept

        log prefix "[NFT-INPUT] DROP: " level warn drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept

        # RULE 1: Allow only PEP port as legitimate ZTA entry point
        tcp dport ${NFTABLES_PEP_PORT} accept

        # RULE 2: Allow Envoy → OPA policy queries; block others
        ip saddr ${NFTABLES_ENVOY_IP} ip daddr ${NFTABLES_OPA_IP} tcp dport ${NFTABLES_OPA_PORTS} accept
        tcp dport ${NFTABLES_OPA_PORTS} log prefix "[CRITICAL] UNAUTHORIZED_OPA_ACCESS: " level crit drop

        # RULE 3: Allow Envoy → API backend; block others
        ip saddr ${NFTABLES_ENVOY_IP} ip daddr ${NFTABLES_API_IP} tcp dport ${NFTABLES_API_PORT} accept
        tcp dport ${NFTABLES_API_PORT} log prefix "[CRITICAL] DIRECT_API_ATTEMPT: " level crit drop

        # RULE 4: Allow API backend → MongoDB; block others
        ip saddr ${NFTABLES_API_IP} ip daddr ${NFTABLES_MONGODB_IP} tcp dport ${NFTABLES_MONGO_PORT} accept
        tcp dport ${NFTABLES_MONGO_PORT} log prefix "[CRITICAL] DIRECT_DB_ATTEMPT: " level crit drop

        # RULE 5: Explicitly block Envoy admin port from outside
        tcp dport ${NFTABLES_ENVOY_ADMIN_PORT} log prefix "[CRITICAL] ENVOY_ADMIN_ATTEMPT: " level crit drop

        # RULE 6: Allow any container → Splunk HEC (for log forwarding)
        ip daddr ${NFTABLES_SPLUNK_IP} tcp dport ${NFTABLES_SIEM_HEC_PORT} accept

        # RULE 7: Allow only corporate subnet to Splunk Web UI
        ip saddr ${NFTABLES_CORPORATE_NET} ip daddr ${NFTABLES_SPLUNK_IP} tcp dport ${NFTABLES_SIEM_WEB_PORT} accept
        tcp dport ${NFTABLES_SIEM_WEB_PORT} log prefix "[WARNING] UNAUTHORIZED_SPLUNK_UI: " level warn drop

        # RULE 8: Default deny - log and drop everything else
        log prefix "[NFT-FWD] DROP: " level info drop
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
