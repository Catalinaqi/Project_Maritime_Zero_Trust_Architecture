#!/usr/sbin/nft -f

# =============================================================================
# MARITIME ZTA - NFTABLES FIREWALL RULES (TEMPLATE)
# Variables resueltas desde docker-compose environment:
#   ENVOY_IP      = pep_gateway
#   OPA_IP        = pdp_engine
#   MONGODB_IP    = db_primary
#   API_IP        = api_backend
#   SPLUNK_IP     = siem_central
#   CORPORATE_NET = corporate_net subnet
# =============================================================================

flush ruleset

table inet filter {

    chain input {
        type filter hook input priority 0; policy drop;

        iif lo accept
        ct state established,related accept
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept

        log prefix "[NFT-INPUT] DROP: " level warn drop
    }

    chain forward {
        type filter hook forward priority 0; policy drop;

        ct state established,related accept
        ip protocol icmp accept
        ip6 nexthdr ipv6-icmp accept

        # REGLA 1: unico ingreso ZTA legitimo
        tcp dport 8443 accept

        # REGLA 2: Envoy → OPA
        ip saddr ${ENVOY_IP} ip daddr ${OPA_IP} tcp dport { 8181, 9191 } accept
        tcp dport { 8181, 9191 } log prefix "[CRITICAL] UNAUTHORIZED_OPA_ACCESS: " level crit drop

        # REGLA 3: Envoy → api_backend
        ip saddr ${ENVOY_IP} ip daddr ${API_IP} tcp dport 3000 accept
        tcp dport 3000 log prefix "[CRITICAL] DIRECT_API_ATTEMPT: " level crit drop

        # REGLA 4: api_backend → MongoDB
        ip saddr ${API_IP} ip daddr ${MONGODB_IP} tcp dport 27017 accept
        tcp dport 27017 log prefix "[CRITICAL] DIRECT_DB_ATTEMPT: " level crit drop

        # REGLA 5: Envoy admin — bloqueo explicito
        tcp dport 9901 log prefix "[CRITICAL] ENVOY_ADMIN_ATTEMPT: " level crit drop

        # REGLA 6: cualquier contenedor → Splunk HEC
        ip daddr ${SPLUNK_IP} tcp dport 8088 accept

        # REGLA 7: Splunk Web UI — solo corporate_net (SOC)
        ip saddr ${CORPORATE_NET} ip daddr ${SPLUNK_IP} tcp dport 8000 accept
        tcp dport 8000 log prefix "[WARNING] UNAUTHORIZED_SPLUNK_UI: " level warn drop

        # REGLA 8: default deny
        log prefix "[NFT-FWD] DROP: " level info drop
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}
