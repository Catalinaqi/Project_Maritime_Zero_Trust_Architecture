#!/usr/sbin/nft -f

# =============================================================================
# MARITIME ZTA - REGOLE DEL FIREWALL NFTABLES (CON PORT MIRRORING PER SNORT)
#
# Data di creazione: 2026-05-11
# Ultimo aggiornamento: 2026-06-19
#
# Queste regole utilizzano variabili provenienti dall'ambiente del container
# (prefisso NFTABLES_). Vengono sostituite all'avvio da envsubst in entrypoint.sh.
#
# Variabili utilizzate in questo file:
#   NFTABLES_ENVOY_IP           - IP del gateway PEP (Envoy)
#   NFTABLES_OPA_IP             - IP del motore PDP (OPA)
#   NFTABLES_MONGODB_IP         - IP del database principale (MongoDB)
#   NFTABLES_API_IP             - IP dell'API backend
#   NFTABLES_SPLUNK_IP          - IP del SIEM (Splunk)
#   NFTABLES_SNORT_IP           - IP dell'IDS Snort (es. 172.20.4.11)
#   NFTABLES_CORPORATE_NET      - Sottorete aziendale (CIDR)
#   NFTABLES_VPN_NET            - Sottorete VPN (CIDR)
#   NFTABLES_SATELLITE_NET      - Sottorete satellitare (CIDR)
#   NFTABLES_PEP_PORT           - Porta esposta da PEP (listener di Envoy)
#   NFTABLES_OPA_PORTS          - Porte di OPA (notazione a set, es. {8181,9191})
#   NFTABLES_MONGO_PORT         - Porta di MongoDB
#   NFTABLES_API_PORT           - Porta dell'API backend
#   NFTABLES_SIEM_HEC_PORT      - Porta Splunk HEC
#   NFTABLES_SIEM_WEB_PORT      - Porta Splunk Web UI
#   NFTABLES_ENVOY_ADMIN_PORT   - Porta dell'interfaccia di amministrazione di Envoy
# =============================================================================

# Svuota tutte le regole esistenti per garantire uno stato pulito
flush ruleset

# ============================================
# TABELLA: inet filter (IPv4 + IPv6) -> ip filter (Solo IPv4)
# ============================================
table ip filter {

    # ============================================
    # CATENA: input
    # Scopo: Filtrare il traffico DESTINATO al container del firewall stesso
    # Policy: drop - Nega di default il traffico in entrata
    # ============================================
    chain input {
        # Blocca tutto ciò che non è esplicitamente permesso
        type filter hook input priority 0; policy drop;

        # CRITICO: Consenti il loopback per le comunicazioni dei processi locali
        iif lo accept

        # CRITICO: Consenti il ritorno delle connessioni stabilite (Stateful)
        ct state established,related accept

        # Consenti il ping ICMP per la diagnostica di rete
        ip protocol icmp accept
        # ip6 nexthdr ipv6-icmp accept

        # ATTENZIONE: Registra tutto il traffico in entrata bloccato
        log prefix "[NFT-INPUT] DROP: " group 0 drop
    }

    # ============================================
    # CATENA: forward
    # Scopo: Filtrare il traffico CHE ATTRAVERSA il firewall tra le reti
    # Policy: drop - Implementa il principio Zero Trust "Mai fidarsi, verificare sempre"
    # ============================================
    chain forward {

        # ====================================================================
        # GRUPPO 0: POLICY DI DEFAULT E GESTIONE DELLO STATO (STATEFUL FIREWALL)
        #
        # Descrizione: Definisce il comportamento di base per tutto il traffico
        # che attraversa il firewall. Applica il principio Zero Trust "Nega di default".
        # Inoltre, ottimizza le prestazioni consentendo immediatamente i pacchetti
        # che appartengono a connessioni già verificate e autorizzate.
        # ====================================================================

        # Gruppo 0: Rule-1
        # Applica una policy restrittiva (drop): tutto ciò che non è esplicitamente permesso viene bloccato
        type filter hook forward priority 0; policy drop;

        # Gruppo 0: Rule-2
        # Ottimizzazione delle prestazioni: accetta i pacchetti di sessioni già stabilite (established) o correlate (related)
        ct state established,related accept

        # Gruppo 0: Rule-3
        # Consenti il protocollo ICMP (IPv4 e IPv6) per scopi di diagnostica e raggiungibilità di rete
        ip protocol icmp accept
        # ip6 nexthdr ipv6-icmp accept

        # ====================================================================
        # GRUPPO 1: ISPEZIONE DEL PERIMETRO (Traffico Utenti -> PEP Envoy)
        #
        # Descrizione: Regola l'unico punto di ingresso legittimo per gli utenti
        # esterni (VPN, Satellitare, Aziendale) verso l'architettura Zero Trust.
        #
        # Monitoraggio Snort: Poiché l'ambiente Docker Desktop su Windows/WSL2 isola
        # il traffico unicast, viene usata la direttiva 'dup to'. Questa clona
        # ogni pacchetto valido e lo inoltra all'IDS Snort per l'ispezione
        # profonda (Deep Packet Inspection), senza generare latenza per l'utente.
        # ====================================================================

        # Gruppo 1: Rule-4
        # Consenti il traffico TCP verso il PEP (Envoy) solo dalle reti autorizzate, clonando il traffico verso Snort per l'ispezione
        ip saddr { ${NFTABLES_VPN_NET}, ${NFTABLES_SATELLITE_NET}, ${NFTABLES_CORPORATE_NET} } ip daddr ${NFTABLES_ENVOY_IP} tcp dport ${NFTABLES_PEP_PORT} accept

        # ====================================================================
        # GRUPPO 2: PROTEZIONE DEL CORE DATI (Accesso a MongoDB)
        #
        # Descrizione: Isola il database MongoDB, che rappresenta il "gioiello della corona".
        # Solo i componenti autorizzati (il gateway Envoy e il backend API) possono
        # comunicare con il database. Qualsiasi altro tentativo viene considerato un attacco.
        #
        # Monitoraggio Snort: Clona tutte le query SQL/NoSQL dirette al DB e le
        # invia a Snort per rilevare tentativi di SQL Injection o esfiltrazione dati.
        # ====================================================================

        # Gruppo 2: Rule-5
        # Consenti l'accesso a MongoDB solo da Envoy e dall'API Backend, clonando il traffico verso Snort
        ip saddr { ${NFTABLES_ENVOY_IP}, ${NFTABLES_API_IP} } ip daddr ${NFTABLES_MONGODB_IP} tcp dport ${NFTABLES_MONGO_PORT} accept

        # Gruppo 2: Rule-6
        # SICUREZZA PROATTIVA: Intercetta e logga con priorità CRITICAL chiunque tenti di aggirare il PEP per toccare direttamente il DB
        tcp dport ${NFTABLES_MONGO_PORT} log prefix "[CRITICAL] DIRECT_DB_ATTEMPT: " group 0 drop

        # ====================================================================
        # GRUPPO 3: PREVENZIONE DEL MOVIMENTO LATERALE (Micro-segmentazione Rigorosa)
        #
        # Descrizione: In un'architettura Zero Trust, le reti degli utenti non devono
        # mai comunicare tra loro. Questo blocco impedisce a un utente malintenzionato
        # che ha compromesso la rete VPN di muoversi lateralmente verso la rete satellitare
        # o viceversa.
        # ====================================================================

        # Gruppo 3: Rule-7
        # Blocca e logga i tentativi di connessione diretta dalla rete VPN alla rete Satellitare
        ip saddr ${NFTABLES_VPN_NET} ip daddr ${NFTABLES_SATELLITE_NET} log prefix "[CRITICAL] LATERAL_VPN_SAT: " group 0 drop

        # Gruppo 3: Rule-8
        # Blocca e logga i tentativi di connessione diretta dalla rete Satellitare alla rete VPN
        ip saddr ${NFTABLES_SATELLITE_NET} ip daddr ${NFTABLES_VPN_NET} log prefix "[CRITICAL] LATERAL_SAT_VPN: " group 0 drop

        # ====================================================================
        # GRUPPO 4: REGOLE DEL PIANO DI CONTROLLO (Control Plane & Monitoraggio)
        #
        # Descrizione: Questo gruppo gestisce i flussi di servizio interni necessari
        # per l'orchestrazione della sicurezza, la verifica delle policy (OPA) e
        # l'accentramento dei log nel SIEM (Splunk).
        # ====================================================================

        # [AUTENTICAZIONE/AUTORIZZAZIONE]: Consenti a Envoy di interrogare l'Engine di Policy (OPA)
        # Gruppo 4: Rule-9
        ip saddr ${NFTABLES_ENVOY_IP} ip daddr ${NFTABLES_OPA_IP} tcp dport ${NFTABLES_OPA_PORTS} accept
        # Gruppo 4: Rule-10
        tcp dport ${NFTABLES_OPA_PORTS} log prefix "[CRITICAL] UNAUTHORIZED_OPA_ACCESS: " group 0 drop

        # [DISPATCHING]: Consenti a Envoy (dopo l'approvazione di OPA) di inoltrare la richiesta valida all'API backend
        # Gruppo 4: Rule-11
        ip saddr ${NFTABLES_ENVOY_IP} ip daddr ${NFTABLES_API_IP} tcp dport ${NFTABLES_API_PORT} accept
        # Gruppo 4: Rule-12
        tcp dport ${NFTABLES_API_PORT} log prefix "[CRITICAL] DIRECT_API_ATTEMPT: " group 0 drop

        # [RE HARDENING]: Blocca i tentativi esterni di accedere alla porta amministrativa di Envoy (porta di management sensibile)
        # Gruppo 4: Rule-13
        tcp dport ${NFTABLES_ENVOY_ADMIN_PORT} log prefix "[CRITICAL] ENVOY_ADMIN_ATTEMPT: " group 0 drop

        # [VISIBILITÀ CENTRALIZZATA]: Consenti a TUTTI i container (inclusi il Firewall e l'IDS Snort) di inviare i propri log a Splunk HEC
        # Gruppo 4: Rule-14
        ip daddr ${NFTABLES_SPLUNK_IP} tcp dport ${NFTABLES_SIEM_HEC_PORT} accept

        # [GESTIONE SICURA]: Consenti SOLO agli amministratori situati nella sottorete Corporate di accedere all'interfaccia grafica di Splunk
        # Gruppo 4: Rule-15
        ip saddr ${NFTABLES_CORPORATE_NET} ip daddr ${NFTABLES_SPLUNK_IP} tcp dport ${NFTABLES_SIEM_WEB_PORT} accept
        # Gruppo 4: Rule-16
        tcp dport ${NFTABLES_SIEM_WEB_PORT} log prefix "[WARNING] UNAUTHORIZED_SPLUNK_UI: " group 0 drop

        # ====================================================================
        # GRUPPO 5: CHIUSURA DI SICUREZZA (Default Deny Finale)
        #
        # Descrizione: La barriera finale. Qualsiasi pacchetto che non ha trovato
        # una corrispondenza nelle regole precedenti viene intercettato qui,
        # registrato nei log di sistema per l'analisi forense e scartato definitivamente.
        # ====================================================================
        # Gruppo 5: Rule-17
        log prefix "[NFT-FWD] DROP: " group 0 drop

    }

    # ============================================
    # CATENA: output
    # Scopo: Filtrare il traffico GENERATO dal firewall stesso
    # Policy: accept - Consenti il traffico in uscita dal firewall
    # ============================================
    chain output {
        type filter hook output priority 0; policy accept;
    }
}
