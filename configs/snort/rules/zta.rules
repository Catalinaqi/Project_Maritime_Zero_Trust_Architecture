# ============================================
# ZTA Custom Rules - Snort 3 IDS
# ============================================
# Author: Network Guardian (Snort/IDS)
# Component: Layer 1 Intrusion Detection System
# Purpose: Detect and alert on 15 attack types
# Data Creation: 2026-05-11
# Last Updated: 2026-06-07
# ============================================

# --- PORT SCANNING ---

# ZTA-001: TCP SYN scan
alert tcp any any -> $HOME_NET any (
    msg:"[ZTA-001] TCP SYN Port Scan";
    flags:S;
    detection_filter:track by_src, count 20, seconds 60;
    sid:1000001; rev:1; priority:2;
)

# ZTA-002: UDP scan
alert udp any any -> $HOME_NET any (
    msg:"[ZTA-002] UDP Port Scan";
    detection_filter:track by_src, count 20, seconds 60;
    sid:1000002; rev:1; priority:2;
)

# ZTA-003: NULL scan (Snort 3 syntax)
alert tcp any any -> $HOME_NET any (
    msg:"[ZTA-003] Stealth Scan NULL/FIN/XMAS";
    flags:0;
    sid:1000003; rev:2; priority:1;
)

# --- SQL INJECTION ---

# ZTA-004: UNION SELECT
alert tcp any any -> 172.20.2.7 8443 (
    msg:"[ZTA-004] SQLi UNION SELECT";
    flow:to_server,established;
    content:"union", nocase;
    content:"select", nocase, distance 0;
    sid:1000004; rev:1; priority:1;
)

# ZTA-005: OR 1=1
alert tcp any any -> 172.20.2.7 8443 (
    msg:"[ZTA-005] SQLi OR 1=1 Bypass";
    flow:to_server,established;
    pcre:"/(\%27)|(\')|(\-\-)|(\%23)|(#)/i";
    content:"or", nocase;
    content:"1=1", nocase, distance 0;
    sid:1000005; rev:1; priority:1;
)

# ZTA-006: DROP TABLE
alert tcp any any -> 172.20.2.7 8443 (
    msg:"[ZTA-006] SQLi DROP TABLE";
    flow:to_server,established;
    content:"drop", nocase;
    pcre:"/drop\s+(table|database|index|procedure)/i";
    sid:1000006; rev:1; priority:1;
)

# --- DIRECT DATABASE ACCESS ---

# ZTA-007: Direct TCP to MongoDB (db_primary 172.20.3.5:27017)
alert tcp any any -> 172.20.3.5 27017 (
    msg:"[ZTA-007] Direct MongoDB Connection Attempt";
    flags:S;
    sid:1000007; rev:1; priority:1;
)

# ZTA-008: MongoDB wire protocol magic bytes
alert tcp any any -> $HOME_NET any (
    msg:"[ZTA-008] MongoDB Wire Protocol Detected";
    flow:to_server,established;
    content:"|d4 07 00 00|";
    sid:1000008; rev:1; priority:2;
)

# --- TLS ANOMALIES ---

# ZTA-009: Plain HTTP on TLS port 8443 (pep_gateway 172.20.2.7)
alert tcp any any -> 172.20.2.7 8443 (
    msg:"[ZTA-009] Unencrypted HTTP on TLS Port 8443";
    flow:to_server,established;
    content:"GET", offset 0, depth 3;
    sid:1000009; rev:1; priority:1;
)

# ZTA-010: Heartbleed signature 0x18 0x03
alert tcp any any -> 172.20.2.7 8443 (
    msg:"[ZTA-010] TLS Heartbleed Attempt";
    flow:to_server,established;
    content:"|18 03|", offset 0, depth 2;
    sid:1000010; rev:1; priority:1;
)

# ZTA-011: TLS downgrade SSLv3/TLS1.0/TLS1.1
alert tcp any any -> 172.20.2.7 8443 (
    msg:"[ZTA-011] TLS Downgrade Attack";
    flow:to_server,established;
    content:"|16 03|", offset 0, depth 2;
    pcre:"/\x16\x03[\x00-\x02]/";
    sid:1000011; rev:2; priority:2;
)

# --- LATERAL MOVEMENT ---

# ZTA-012: VPN client (operatore_ancona .11.x) accessing Corporate net (.10.x)
alert tcp 172.20.11.0/24 any -> 172.20.10.0/24 any (
    msg:"[ZTA-012] Lateral Movement VPN->Corporate";
    flags:S;
    sid:1000012; rev:2; priority:1;
)

# ZTA-013: SSH brute force on pep_gateway
alert tcp any any -> 172.20.2.7 22 (
    msg:"[ZTA-013] SSH Brute Force";
    flow:to_server,established;
    detection_filter:track by_src, count 5, seconds 60;
    sid:1000013; rev:1; priority:1;
)

# --- DDOS / RESOURCE EXHAUSTION ---

# ZTA-014: SYN flood
alert tcp any any -> $HOME_NET any (
    msg:"[ZTA-014] SYN Flood DDoS";
    flags:S;
    detection_filter:track by_dst, count 100, seconds 10;
    sid:1000014; rev:1; priority:1;
)

# ZTA-015: HTTP Slowloris (POST flood on pep_gateway)
alert tcp any any -> 172.20.2.7 8443 (
    msg:"[ZTA-015] HTTP Slowloris Attack";
    flow:to_server,established;
    content:"POST", offset 0, depth 4;
    detection_filter:track by_src, count 50, seconds 60;
    sid:1000015; rev:1; priority:1;
)

alert icmp any any -> any any (msg:"ZTA-DEBUG-PING-DETECTED"; sid:1000001; rev:1;)
