# =============================================================================
# MARITIME ZTA - SNORT 3 RULES
# IDS: ids_network_monitor (snort3) | Interface: any
# =============================================================================
# Variables inyectadas via snort-zta.lua desde variables de entorno:
# HOME_NET, EXTERNAL_NET, PUBLIC_NET, VPN_NET, SATELLITE_NET, CORPORATE_NET, BACKEND_NET
# PEP_PORT, OPA_PORTS, MONGO_PORT, API_PORT, SIEM_PORTS, ADMIN_PORT
# =============================================================================

# =============================================================================
# CAT 0: DIAGNOSTICO Y PRUEBAS MVP (Test del Pipeline a Splunk)
# =============================================================================

# 1. Prueba de Ping MVP (Se mantiene igual)
alert icmp any any -> any any (msg:"[ZTA-MVP-001] INTRUDER PING DETECTED"; sid:999901; rev:2;)

# 2. Prueba de TCP SYN Scan (Se mantiene igual)
alert tcp any any -> any any (msg:"[ZTA-MVP-002] TCP SYN SCAN ATTEMPT"; flags:S; sid:999902; rev:2; priority:2;)

# 3. FIX: SQLi en Envoy. Cambiamos flow a 'to_server' y quitamos 'established'
# Por qué: Envoy (PEP) negocia TLS, pero para la prueba usaremos HTTP simple.
alert tcp any any -> $HOME_NET $PEP_PORT (msg:"[ZTA-MVP-003] SQLi ATTEMPT ON ENVOY"; flow:to_server; content:"union",nocase; content:"select",nocase,distance 0,within 50; sid:999903; rev:5; priority:1;)

# 4. Prueba MongoDB Bypass (Se mantiene igual)
alert tcp any any -> $HOME_NET $MONGO_PORT (msg:"[ZTA-MVP-004] DIRECT MONGODB ATTEMPT"; flags:S; sid:999904; rev:1; priority:1;)

# -----------------------------------------------------------------------------
# CAT 1: RECONOCIMIENTO
# -----------------------------------------------------------------------------

alert tcp $EXTERNAL_NET any -> $HOME_NET any (
    msg:"[ZTA-001] RECON: TCP SYN Port Scan";
    flags:S;
    detection_filter:track by_src, count 20, seconds 60;
    sid:1000001; rev:1; priority:2;)

alert udp $EXTERNAL_NET any -> $HOME_NET any (
    msg:"[ZTA-002] RECON: UDP Port Scan";
    detection_filter:track by_src, count 20, seconds 60;
    sid:1000002; rev:1; priority:2;)

alert tcp any any -> $HOME_NET any (
    msg:"[ZTA-003] RECON: Stealth Scan NULL/FIN/XMAS";
    flags:!APRUSF12;
    sid:1000003; rev:1; priority:1;)

alert tcp any any -> $HOME_NET any (
    msg:"[ZTA-004] DDOS: SYN Flood";
    flags:S;
    detection_filter:track by_dst, count 100, seconds 10;
    sid:1000004; rev:1; priority:1;)

alert tcp any any -> $HOME_NET $PEP_PORT (
    msg:"[ZTA-005] DDOS: Slowloris en Envoy PEP";
    flow:to_server,established;
    content:"POST", offset 0, depth 4;
    detection_filter:track by_src, count 50, seconds 60;
    sid:1000005; rev:1; priority:1;)

# -----------------------------------------------------------------------------
# CAT 2: EVASION DEL PEP — acceso directo a servicios internos
# En ZTA todo trafico DEBE pasar por pep_gateway:$PEP_PORT.
# Cualquier conexion directa a estos puertos es bypass del plano de control.
# -----------------------------------------------------------------------------

alert tcp any any -> $HOME_NET $MONGO_PORT (
    msg:"[ZTA-006] BYPASS: Acceso directo a MongoDB - Evasion PEP";
    flags:S;
    sid:1000006; rev:1; priority:1;)

alert tcp any any -> $HOME_NET $API_PORT (
    msg:"[ZTA-007] BYPASS: Acceso directo a api_backend - Evasion PEP";
    flags:S;
    sid:1000007; rev:1; priority:1;)

alert tcp any any -> $HOME_NET $OPA_PORTS (
    msg:"[ZTA-008] BYPASS: Acceso directo a OPA pdp_engine - Evasion PEP";
    flags:S;
    sid:1000008; rev:1; priority:1;)

alert tcp any any -> $HOME_NET $ADMIN_PORT (
    msg:"[ZTA-009] CRITICAL: Acceso a Envoy Admin Interface";
    flags:S;
    sid:1000009; rev:1; priority:1;)

alert tcp any any -> $HOME_NET $SIEM_PORTS (
    msg:"[ZTA-010] BYPASS: Acceso directo a Splunk SIEM";
    flags:S;
    detection_filter:track by_src, count 10, seconds 30;
    sid:1000010; rev:1; priority:2;)

# -----------------------------------------------------------------------------
# CAT 3: ANOMALIAS mTLS en pep_gateway
# El puerto PEP_PORT solo debe recibir TLS 1.2+. Cualquier otra cosa es
# violacion de politica o ataque activo al canal cifrado.
# -----------------------------------------------------------------------------

alert tcp any any -> $HOME_NET $PEP_PORT (
    msg:"[ZTA-011] POLICY: HTTP cleartext en puerto mTLS";
    flow:to_server,established;
    content:"GET", offset 0, depth 3;
    sid:1000011; rev:1; priority:1;)

alert tcp any any -> $HOME_NET $PEP_PORT (
    msg:"[ZTA-012] POLICY: HTTP POST cleartext en puerto mTLS";
    flow:to_server,established;
    content:"POST", offset 0, depth 4;
    sid:1000012; rev:1; priority:1;)

alert tcp any any -> $HOME_NET $PEP_PORT (
    msg:"[ZTA-013] CRYPTO: TLS Downgrade SSLv3/TLS1.0/TLS1.1";
    flow:to_server,established;
    content:"|16 03|", offset 0, depth 2;
    pcre:"/\x16\x03[\x00-\x02]/";
    sid:1000013; rev:2; priority:1;)

alert tcp any any -> $HOME_NET $PEP_PORT (
    msg:"[ZTA-014] CRYPTO: TLS Heartbleed - Lectura de memoria remota";
    flow:to_server,established;
    content:"|18 03|", offset 0, depth 2;
    sid:1000014; rev:1; priority:1;)

# =============================================================================
# CAT 4: INYECCION EN CAPA DE APLICACION
# =============================================================================

alert tcp any any -> $HOME_NET [$PEP_PORT,$API_PORT] (
    msg:"[ZTA-015] INJECT: SQL UNION SELECT";
    flow:to_server;
    content:"union", nocase;
    content:"select", nocase, distance 0;
    sid:1000015; rev:2; priority:1;)

# --- AGREGAR ESTA REGLA PARA TU PRUEBA 5 ---
alert tcp any any -> $HOME_NET [$PEP_PORT,$API_PORT] (
    msg:"[ZTA-019] INJECT: Command Injection (cat /etc/passwd)";
    flow:to_server;
    content:"cat ", nocase;
    content:"/etc/passwd", nocase, distance 0;
    sid:1000019; rev:1; priority:1;)
# -------------------------------------------

alert tcp any any -> $HOME_NET [$PEP_PORT,$API_PORT] (
    msg:"[ZTA-018] INJECT: DROP TABLE/COLLECTION - Destruccion de datos";
    flow:to_server;
    content:"drop", nocase;
    pcre:"/drop\s+(table|database|collection|index)/i";
    sid:1000018; rev:2; priority:1;)

# -----------------------------------------------------------------------------
# CAT 5: EXFILTRACION DE DATOS
# MongoDB wire protocol identificado por magic bytes del protocolo.
# Si aparece fuera del backend_net indica tunel o exfiltracion activa.
# -----------------------------------------------------------------------------

alert tcp any any -> any any (
    msg:"[ZTA-020] EXFIL: MongoDB Wire Protocol detectado en red";
    flow:to_server,established;
    content:"|d4 07 00 00|";
    sid:1000020; rev:2; priority:2;)

alert tcp $HOME_NET any -> $EXTERNAL_NET any (
    msg:"[ZTA-021] EXFIL: Volumen anomalo de datos salientes desde HOME_NET";
    flow:to_server,established;
    detection_filter:track by_src, count 500, seconds 60;
    sid:1000021; rev:1; priority:2;)

# -----------------------------------------------------------------------------
# CAT 6: MOVIMIENTO LATERAL entre subredes ZTA
# Cada red tiene un rol unico. El cruce entre redes sin pasar por el PEP
# rompe el modelo ZTA y permite escalada de privilegios entre segmentos.
# -----------------------------------------------------------------------------

alert tcp $PUBLIC_NET any -> $VPN_NET any (
    msg:"[ZTA-022] LATERAL: public_net -> vpn_net (operadores banchina)";
    flags:S;
    sid:1000022; rev:1; priority:1;)

alert tcp $PUBLIC_NET any -> $SATELLITE_NET any (
    msg:"[ZTA-023] LATERAL: public_net -> satellite_net (capitanos)";
    flags:S;
    sid:1000023; rev:1; priority:1;)

alert tcp $PUBLIC_NET any -> $CORPORATE_NET any (
    msg:"[ZTA-024] LATERAL: public_net -> corporate_net (SOC)";
    flags:S;
    sid:1000024; rev:1; priority:1;)

alert tcp $PUBLIC_NET any -> $BACKEND_NET any (
    msg:"[ZTA-025] LATERAL: public_net -> backend_net (acceso directo a datos)";
    flags:S;
    sid:1000025; rev:1; priority:1;)

alert tcp $SATELLITE_NET any -> $CORPORATE_NET any (
    msg:"[ZTA-026] LATERAL: satellite_net -> corporate_net (escalada capitano->SOC)";
    flags:S;
    sid:1000026; rev:1; priority:1;)

alert tcp $SATELLITE_NET any -> $BACKEND_NET any (
    msg:"[ZTA-027] LATERAL: satellite_net -> backend_net directo";
    flags:S;
    sid:1000027; rev:1; priority:1;)

alert tcp $VPN_NET any -> $BACKEND_NET any (
    msg:"[ZTA-028] LATERAL: vpn_net -> backend_net directo (evasion api_backend)";
    flags:S;
    sid:1000028; rev:1; priority:1;)

# -----------------------------------------------------------------------------
# CAT 7: FUERZA BRUTA Y ABUSO DE CREDENCIALES
# -----------------------------------------------------------------------------

alert tcp any any -> $HOME_NET 22 (
    msg:"[ZTA-029] BRUTE: SSH Brute Force - Contenedores no deben exponer SSH";
    flow:to_server,established;
    detection_filter:track by_src, count 5, seconds 60;
    sid:1000029; rev:1; priority:1;)

alert tcp any any -> $HOME_NET $SIEM_PORTS (
    msg:"[ZTA-030] BRUTE: Fuerza bruta Splunk Web/HEC";
    flow:to_server,established;
    detection_filter:track by_src, count 10, seconds 60;
    sid:1000030; rev:1; priority:2;)

alert tcp any any -> $HOME_NET $OPA_PORTS (
    msg:"[ZTA-031] BRUTE: Fuerza bruta OPA REST API";
    flow:to_server,established;
    detection_filter:track by_src, count 15, seconds 30;
    sid:1000031; rev:1; priority:1;)

# -----------------------------------------------------------------------------
# CAT 8: MANIPULACION DEL PLANO DE CONTROL ZTA
# OPA expone una REST API que permite reescribir politicas Rego en caliente
# con PUT /v1/policies y modificar datos con PUT /v1/data.
# Un atacante que alcance OPA directamente puede concederse acceso total.
# Splunk HEC acepta eventos JSON: log poisoning puede cegar al SIEM.
# -----------------------------------------------------------------------------

alert tcp any any -> $HOME_NET $OPA_PORTS (
    msg:"[ZTA-032] POLICY TAMPER: PUT /v1/policies en OPA - Reescritura de politica ZTA";
    flow:to_server,established;
    content:"PUT", offset 0, depth 3;
    content:"/v1/policies", nocase;
    sid:1000032; rev:1; priority:1;)

alert tcp any any -> $HOME_NET $OPA_PORTS (
    msg:"[ZTA-033] POLICY TAMPER: PUT /v1/data en OPA - Modificacion de datos de decision";
    flow:to_server,established;
    content:"PUT", offset 0, depth 3;
    content:"/v1/data", nocase;
    sid:1000033; rev:1; priority:1;)

alert tcp any any -> $HOME_NET $OPA_PORTS (
    msg:"[ZTA-034] POLICY TAMPER: DELETE en OPA REST API - Borrado de politica";
    flow:to_server,established;
    content:"DELETE", offset 0, depth 6;
    sid:1000034; rev:1; priority:1;)

alert tcp any any -> $HOME_NET $SIEM_PORTS (
    msg:"[ZTA-035] SIEM: Log flooding en Splunk HEC - Posible ceguera del SIEM";
    flow:to_server,established;
    detection_filter:track by_src, count 200, seconds 10;
    sid:1000035; rev:1; priority:2;)
